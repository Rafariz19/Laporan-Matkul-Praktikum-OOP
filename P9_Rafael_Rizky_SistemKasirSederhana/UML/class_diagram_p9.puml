@startuml
skinparam classAttributeIconSize false
skinparam style strictuml
skinparam packageStyle rectangle
skinparam shadowing false
skinparam roundcorner 5

title UML CLASS DIAGRAM - SISTEM KASIR SEDERHANA (MODUL 9)
footer Mahasiswa: Rafael Rizky Luga Tanjung (NRP: 3125522007) - PENS PSDKU Sumenep (2026)

package "model" {

    interface DapatDidiskon <<Interface>> {
        + {abstract} getHarga() : int
        + hitungDiskon(persentase: double) : double
        + getHargaSetelahDiskon(persentase: double) : double
    }

    abstract class Produk <<Abstract Class>> {
        - kode : String
        - nama : String
        - harga : int
        - stok : int
        + Produk(kode: String, nama: String, harga: int, stok: int)
        + getKode() : String
        + getNama() : String
        + getHarga() : int
        + getStok() : int
        + ubahNama(namaBaru: String) : boolean
        + ubahHarga(hargaBaru: int) : boolean
        + tambahStok(jumlah: int) : boolean
        + kurangiStok(jumlah: int) : boolean
        + cekKetersediaan(jumlah: int) : boolean
        + hitungNilaiInventaris() : int
        + {abstract} getKategoriInfo() : String
        + {abstract} tampilkanDetailKhusus() : void
        + tampilkanData() : void
    }

    class ProdukMakanan {
        - tanggalKadaluarsa : String
        + ProdukMakanan(kode: String, nama: String, harga: int, stok: int, tanggalKadaluarsa: String)
        + getTanggalKadaluarsa() : String
        + ubahTanggalKadaluarsa(tanggalBaru: String) : boolean
        + getKategoriInfo() : String
        + tampilkanDetailKhusus() : void
    }

    class ProdukElektronik {
        - garansiBulan : int
        + ProdukElektronik(kode: String, nama: String, harga: int, stok: int, garansiBulan: int)
        + getGaransiBulan() : int
        + ubahGaransiBulan(garansiBaru: int) : boolean
        + getKategoriInfo() : String
        + tampilkanDetailKhusus() : void
    }

    class Pelanggan {
        - idPelanggan : String
        - nama : String
        - nomorHP : String
        - tipeMember : String
        + Pelanggan(idPelanggan: String, nama: String, nomorHP: String, tipeMember: String)
        + getIdPelanggan() : String
        + getNama() : String
        + getNomorHP() : String
        + getTipeMember() : String
        + getDiskon() : double
        + ubahNama(namaBaru: String) : boolean
        + ubahNomorHP(nomorHPBaru: String) : boolean
        + ubahTipeMember(tipeMemberBaru: String) : boolean
        + hitungPotonganMember(totalBelanja: double) : double
        + tampilkanData() : void
    }

    class ItemTransaksi {
        - produk : Produk
        - jumlahBeli : int
        - diskonItem : double
        + ItemTransaksi(produk: Produk, jumlahBeli: int)
        + ItemTransaksi(produk: Produk, jumlahBeli: int, diskonItem: double)
        + getProduk() : Produk
        + getJumlahBeli() : int
        + getDiskonItem() : double
        + ubahJumlahBeli(jumlahBaru: int) : boolean
        + ubahDiskonItem(diskonBaru: double) : boolean
        + hitungSubtotalGross() : int
        + hitungNominalDiskonItem() : double
        + hitungSubtotal() : int
        + tampilkanItem() : void
    }

    class Transaksi {
        - idTransaksi : String
        - tanggal : String
        - pelanggan : Pelanggan
        - daftarItem : List<ItemTransaksi>
        - statusTransaksi : String
        + Transaksi(idTransaksi: String, tanggal: String, pelanggan: Pelanggan)
        + getIdTransaksi() : String
        + getTanggal() : String
        + getPelanggan() : Pelanggan
        + getDaftarItem() : List<ItemTransaksi>
        + getStatusTransaksi() : String
        + tambahItem(produk: Produk, jumlahBeli: int) : boolean
        + tambahItem(produk: Produk, jumlahBeli: int, diskonPromosi: double) : boolean
        + batalkanItem(index: int) : boolean
        + hitungTotalSubtotal() : int
        + hitungDiskonNominal() : double
        + hitungTotalBayar() : double
        + prosesTransaksi() : void
        + prosesTransaksi(uangDiterima: double) : boolean
    }
}

' --- RELASI & MULTIPLICITY ---
Produk <|-- ProdukMakanan : extends
Produk <|-- ProdukElektronik : extends

DapatDidiskon <|.. ProdukMakanan : implements
DapatDidiskon <|.. ProdukElektronik : implements

Transaksi "1" --> "0..1" Pelanggan : association (uses-a)
Transaksi "1" *-- "1..*" ItemTransaksi : composition (part-of)
ItemTransaksi "*" o-- "1" Produk : aggregation (references)

@enduml
